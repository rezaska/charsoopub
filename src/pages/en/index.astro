---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";
import { url } from "../../lib/url";
const issues = await getCollection("issues");
const books = await getCollection("books");
---

<Base title="Charsoo Publishing — Tehran">
  <div class="wrap page" dir="ltr" lang="en">
    <h1>Payam Charsoo</h1>
    <p class="lede">
      A literary and performing-arts publisher in Tehran, and home of
      <em>Charsoo Quarterly</em> — a theatre and cinema journal licensed in both
      Persian and English.
    </p>
    <p>
      The quarterly has published {issues.length} issues, each devoted to a single
      play: Hamlet, Macbeth, Romeo and Juliet, Othello, King Lear, Richard III,
      The Cherry Orchard and The Seagull. Contributors have included exclusive
      interviews with Peter Brook and with Eugenio Barba and Julia Varley.
      The press has published {books.length} titles since 2019.
    </p>
    <p>
      For subscriptions, stockist enquiries or rights, write to
      <a href="mailto:charsoomagazine@gmail.com">charsoomagazine@gmail.com</a>.
    </p>
    <p><a href={url("/")}>بازگشت به سایت فارسی ←</a></p>
  </div>
</Base>

<style>
  .page { padding-block: clamp(2rem, 5vw, 3.4rem); max-width: 62ch; line-height: 1.7; }
  h1 { font-size: var(--s-3); font-weight: 900; margin-bottom: 1rem; }
  .lede { font-size: var(--s-1); margin-bottom: 1.2rem; }
  p { margin-bottom: 1rem; color: var(--ink-soft); }
  a { text-decoration: underline; }
</style>
