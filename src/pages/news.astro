---
import Base from "../layouts/Base.astro";
---

<Base title="اخبار — انتشارات پیام چارسو">
  <div class="wrap page">
    <h1>اخبار و رویدادها</h1>
    <p class="empty">
      به‌زودی اخبار و رویدادهای انتشارات و فصلنامه در این بخش منتشر خواهد شد.
    </p>
  </div>
</Base>

<style>
  .page { padding-block: clamp(2rem, 5vw, 3.4rem); min-height: 40vh; }
  h1 { font-size: var(--s-3); font-weight: 900; margin-bottom: 1rem; }
  .empty { color: var(--ink-soft); max-width: var(--measure); }
</style>
