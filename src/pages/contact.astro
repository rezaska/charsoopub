---
import Base from "../layouts/Base.astro";
---

<Base title="تماس با ما — انتشارات پیام چارسو">
  <div class="wrap page">
    <h1>تماس با ما</h1>
    <div class="cols">
      <section>
        <h2>نشانی</h2>
        <p>تهران، ونک، خدامی، خیابان آفتاب، ساختمان آفتاب<br />به‌نام فصلنامه‌ی پیام چارسو</p>
        <h2>تلفن</h2>
        <p class="num ltr">۰۲۱۲۲۷۸۰۸۱۰</p>
        <p class="num ltr">۰۹۱۲۲۴۰۶۹۵۹ — رزرو آگهی</p>
        <h2>ایمیل</h2>
        <p><a class="ltr" href="mailto:charsoomagazine@gmail.com">charsoomagazine@gmail.com</a></p>
      </section>
      <section>
        <h2>تهیه‌ی کتاب‌ها و فصلنامه</h2>
        <p>کتاب‌ها و مجله‌های چارسو را از این راه‌ها می‌توانید تهیه کنید:</p>
        <ul>
          <li>واتساپ، بله یا پیامک به <span class="num ltr">۰۹۱۰۲۲۴۵۴۰۸</span></li>
          <li>تماس با <span class="num ltr">۰۹۱۲۲۴۰۶۹۵۹</span></li>
          <li>دایرکت <a class="ltr" href="https://www.instagram.com/charsoopub/" rel="noopener">اینستاگرام</a></li>
          <li>ایمیل <a class="ltr" href="mailto:charsoomagazine@gmail.com">charsoomagazine@gmail.com</a></li>
          <li>کتاب‌فروشی‌های پخش ققنوس</li>
          <li><a class="ltr" href="https://www.iranketab.ir/publisher/2278-%da%86%d8%a7%d8%b1%d8%b3%d9%88" rel="noopener">ایران‌کتاب</a> — در حال حاضر برای برخی عنوان‌ها</li>
        </ul>
        <h2>اینستاگرام</h2>
        <p><a class="ltr" href="https://www.instagram.com/charsoopub/" rel="noopener">instagram.com/charsoopub</a></p>
      </section>
    </div>
  </div>
</Base>

<style>
  .page { padding-block: clamp(2rem, 5vw, 3.4rem); }
  h1 { font-size: var(--s-3); font-weight: 900; margin-bottom: 1.6rem; }
  .cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr)); gap: clamp(1.6rem, 4vw, 3rem); }
  h2 { font-size: var(--s--1); font-weight: 700; color: var(--accent); margin: 1.4rem 0 0.4rem; }
  section > h2:first-child { margin-top: 0; }
  p, li { color: var(--ink-soft); }
  ul { margin: 0.3rem 0 0; padding-inline-start: 1.1rem; }
</style>
