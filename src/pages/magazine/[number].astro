---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { fa, toman, seasonLabel, onAccent } from "../../lib/fa";

export async function getStaticPaths() {
  const issues = await getCollection("issues");
  return issues.map((issue) => ({
    params: { number: String(issue.data.number) },
    props: { issue },
  }));
}

const { issue } = Astro.props;
const d = issue.data;
const { Content } = await render(issue);
const fg = onAccent(d.accent);
---

<Base
  title={`ویژه‌نامه‌ی ${d.play} — شماره‌ی ${fa(d.number)}`}
  description={`فصلنامه‌ی پیام چارسو، شماره‌ی ${fa(d.number)}، ویژه‌نامه‌ی ${d.play}`}
  accent={d.accent}
  onAccent={fg}
>
  <!-- The colour band, exactly as it sits on the printed cover. -->
  <div class="band">
    <div class="wrap band-inner">
      <span class="n num">{fa(d.number)}</span>
      <div>
        <h1>ویژه‌نامه‌ی {d.play}</h1>
        <p class="season">
          {seasonLabel(d.number)}
          {d.season && d.year && <> · {d.season} {fa(d.year)}</>}
          {" · فصلنامه‌ی پیام چارسو"}
        </p>
      </div>
    </div>
  </div>

  <div class="wrap body">
    <aside>
      {d.cover && <img src={d.cover} alt={`جلد ویژه‌نامه‌ی ${d.play}`} width="520" height="680" />}
      {d.coverNeedsOriginal && (
        <p class="warn">تصویر جلد با کیفیت پایین — فایل اصلی مورد نیاز است.</p>
      )}
      <dl class="spec">
        <div><dt>شماره</dt><dd class="num">{fa(d.number)}</dd></div>
        <div><dt>نمایشنامه</dt><dd>{d.play}</dd></div>
        {d.playwright && <div><dt>نویسنده</dt><dd>{d.playwright}</dd></div>}
        {d.price != null && <div><dt>قیمت</dt><dd class="num">{toman(d.price)}</dd></div>}
        <div><dt>زبان</dt><dd>فارسی / انگلیسی</dd></div>
      </dl>
    </aside>

    <div>
      {issue.body?.trim() && <div class="intro"><Content /></div>}

      {d.toc.length > 0 && (
        <section class="toc-wrap">
          <h2>فهرست مطالب</h2>
          <ul class="toc">
            {d.toc.map((t) => (
              <li>
                <span class="kind">{t.kind}</span>
                <span class="t">
                  {t.title}
                  {t.by && <span class="by">{t.by}</span>}
                </span>
                {t.page && <span class="pg num">{fa(t.page)}</span>}
              </li>
            ))}
          </ul>
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  .band { background: var(--accent); color: var(--on-accent); }
  .band-inner {
    display: flex; align-items: center; gap: clamp(1rem, 3vw, 2rem);
    padding-block: clamp(1.4rem, 3.5vw, 2.4rem); flex-wrap: wrap;
  }
  .n {
    font-size: clamp(2.4rem, 6vw, 4rem); font-weight: 900; line-height: 1;
    background: rgb(255 255 255 / 0.18); padding: 0.08em 0.32em; border-radius: 3px;
  }
  .band h1 { font-size: clamp(1.4rem, 3.4vw, 2.2rem); font-weight: 900; }
  .season { opacity: 0.85; font-size: var(--s--1); }

  .body {
    display: grid;
    grid-template-columns: minmax(0, 270px) minmax(0, 1fr);
    gap: clamp(1.4rem, 4vw, 3rem);
    padding-block: clamp(1.6rem, 4vw, 3rem);
  }
  @media (max-width: 760px) { .body { grid-template-columns: 1fr; } }
  aside img { width: 100%; box-shadow: 0 2px 8px rgb(0 0 0 / 0.14), 0 20px 44px rgb(0 0 0 / 0.16); }
  .warn {
    margin-top: 0.7rem; font-size: var(--s--1); color: var(--accent);
    border-inline-start: 2px solid var(--accent); padding-inline-start: 0.6rem;
  }
  .spec { margin: 1rem 0 0; display: flex; flex-direction: column; gap: 0.1rem; }
  .spec div {
    display: flex; justify-content: space-between; gap: 1rem;
    padding: 0.42rem 0; border-bottom: 1px dotted var(--rule);
    font-size: var(--s--1);
  }
  .spec dt { color: var(--ink-soft); margin: 0; }
  .spec dd { margin: 0; font-weight: 500; }

  .intro { max-width: var(--measure); color: var(--ink-soft); margin-bottom: 2rem; }
  .toc-wrap h2 {
    font-size: var(--s--1); font-weight: 700; letter-spacing: 0.05em;
    color: var(--accent); margin-bottom: 0.7rem;
  }
  .toc { list-style: none; margin: 0; padding: 0; }
  .toc li {
    display: flex; gap: 0.8rem; align-items: baseline;
    padding: 0.7rem 0; border-bottom: 1px solid var(--rule);
  }
  .toc li:last-child { border-bottom: 0; }
  .kind {
    flex: 0 0 auto; min-width: 5.2em; text-align: center;
    font-size: var(--s--1); font-weight: 700;
    background: var(--accent); color: var(--on-accent);
    padding: 0.16em 0.5em; border-radius: 2px;
  }
  .toc .t { line-height: 1.6; }
  .by { display: block; font-size: var(--s--1); color: var(--ink-soft); }
  .pg { margin-inline-start: auto; color: var(--ink-faint); font-size: var(--s--1); }
</style>
