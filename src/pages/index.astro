---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import BookCard from "../components/BookCard.astro";
import IssueCard from "../components/IssueCard.astro";
import { fa, seasonLabel, onAccent, shamsi } from "../lib/fa";
import { url } from "../lib/url";

const books = (await getCollection("books")).sort((a, b) => a.data.order - b.data.order);
const news = (await getCollection("news"))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);
const issues = (await getCollection("issues")).sort((a, b) => b.data.number - a.data.number);
const latest = issues[0];
const a = latest.data.accent;
---

<Base title="انتشارات پیام چارسو">
  <section class="hero" style={`--a:${a};--on-a:${onAccent(a)}`}>
    <div class="wrap hero-grid">
    <div class="art">
      {latest.data.cover && (
        <img src={url(latest.data.cover)} alt={`جلد ویژه‌نامه‌ی ${latest.data.play}`}
             width="520" height="680" fetchpriority="high" />
      )}
    </div>
    <div class="copy">
      <p class="kicker"><span class="bar"></span>شماره‌ی {fa(latest.data.number)} · {seasonLabel(latest.data.number)}</p>
      <h1>ویژه‌نامه‌ی {latest.data.play}</h1>
      <p class="sub">فصلنامه‌ی تخصصی سینما و تئاتر پیام چارسو</p>
      <p class="dek">{latest.body}</p>
      <p class="cta">
        <a class="btn" href={url(`/magazine/${latest.data.number}/`)}>مشاهده‌ی فهرست مطالب</a>
        <a class="btn ghost" href={url("/contact/")}>تهیه‌ی نسخه‌ی چاپی</a>
      </p>
    </div>
    </div>
  </section>

  {news.length > 0 && (
    <section class="wrap block news-strip">
      <header class="block-head">
        <h2>اخبار</h2>
        <a href={url("/news/")}>همه‌ی اخبار ←</a>
      </header>
      <ul>
        {news.map((n) => (
          <li>
            <a href={url(`/news/${n.id}/`)}>
              <time datetime={n.data.date.toISOString().slice(0, 10)}>{shamsi(n.data.date)}</time>
              <span class="t">{n.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap block">
    <header class="block-head">
      <h2>تازه‌های انتشارات</h2>
      <a href={url("/books/")}>همه‌ی کتاب‌ها ←</a>
    </header>
    <div class="grid books">
      {books.slice(0, 8).map((b) => (
        <BookCard slug={b.id} {...b.data} />
      ))}
    </div>
  </section>

  <section class="wrap block">
    <header class="block-head">
      <h2>آرشیو فصلنامه</h2>
      <a href={url("/magazine/")}>{fa(issues.length)} شماره ←</a>
    </header>
    <div class="grid issues">
      {issues.map((i) => <IssueCard {...i.data} />)}
    </div>
  </section>
</Base>

<style>
  /* Sits in the same column as every other section, so the cover's edge
     lines up with the headings and card grid below it. */
  .hero {
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    padding-block: clamp(1.4rem, 3.5vw, 2.8rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(1.2rem, 3vw, 2.6rem);
  }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } }
  .art {
    display: grid;
    place-items: center;
    padding: clamp(0.6rem, 2vw, 1.4rem);
  }
  .art img { width: min(78%, 310px); box-shadow: var(--cover-ring), var(--hero-shadow); }
  .copy {
    padding-block: clamp(0.6rem, 2vw, 1.6rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    max-width: 52ch;
  }
  .kicker {
    display: flex; align-items: center; gap: 0.6rem;
    font-weight: 700; font-size: var(--s--1); color: var(--a);
  }
  .bar { height: 3px; width: 34px; background: var(--a); border-radius: 2px; }
  .copy h1 { font-size: var(--s-3); font-weight: 900; }
  .sub { color: var(--ink-soft); font-size: var(--s-0); }
  .dek { color: var(--ink-soft); max-width: var(--measure); }
  .cta { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.4rem; }
  .btn {
    background: var(--a); color: var(--on-a);
    padding: 0.62rem 1.2rem; border-radius: 3px;
    font-weight: 700; font-size: var(--s--1);
  }
  .btn.ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px var(--rule); }
  .btn:hover { text-decoration: none; filter: brightness(0.94); }

  .block { padding-block: clamp(2.2rem, 5vw, 3.6rem); }
  .block-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; margin-bottom: 1.4rem; flex-wrap: wrap;
  }
  .block-head h2 { font-size: var(--s-2); }
  .block-head a { font-size: var(--s--1); color: var(--ink-soft); }
  .news-strip ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 0;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  }
  .news-strip li { border-top: 2px solid var(--rule); }
  .news-strip li a {
    display: flex; flex-direction: column; gap: 0.3rem;
    padding: 0.8rem 0; padding-inline-end: 1.2rem;
  }
  .news-strip a:hover { text-decoration: none; }
  .news-strip a:hover .t { color: var(--accent); }
  .news-strip time { font-size: var(--s--1); color: var(--ink-faint); }
  .news-strip .t {
    font-size: var(--s-0); font-weight: 500; line-height: 1.6;
    transition: color 0.15s ease;
  }

  .grid { display: grid; gap: clamp(0.9rem, 2.2vw, 1.6rem); }
  .books { grid-template-columns: repeat(auto-fill, minmax(165px, 1fr)); }
  .issues { grid-template-columns: repeat(auto-fill, minmax(135px, 1fr)); }
</style>
