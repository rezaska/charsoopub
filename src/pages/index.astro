---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import BookCard from "../components/BookCard.astro";
import IssueCard from "../components/IssueCard.astro";
import { fa, shamsi } from "../lib/fa";
import { url } from "../lib/url";
import { pickHero } from "../lib/hero";

const books = (await getCollection("books")).sort((a, b) => a.data.order - b.data.order);
const issues = (await getCollection("issues")).sort((a, b) => b.data.number - a.data.number);
const news = (await getCollection("news")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const hero = pickHero(issues, books, news);
---

<Base title="انتشارات پیام چارسو">
  <section class="hero" style={`--a:${hero.accent};--on-a:${hero.onAccent}`}>
    <div class="wrap hero-grid">
      <a class="art" href={url(hero.href)} aria-label={hero.title}>
        {hero.image && (
          <img src={url(hero.image)} alt={`جلد ${hero.title}`}
               width="520" height="680" fetchpriority="high" />
        )}
      </a>
      <div class="copy">
        <p class="kicker"><span class="bar"></span>{hero.kicker}</p>
        <h1>{hero.title}</h1>
        {hero.sub && <p class="sub">{hero.sub}</p>}
        {hero.dek && <p class="dek">{hero.dek}</p>}
        <p class="cta">
          <a class="btn" href={url(hero.href)}>{hero.cta}</a>
          {hero.altHref && <a class="btn ghost" href={url(hero.altHref)}>{hero.altCta}</a>}
        </p>
      </div>
    </div>
  </section>

  {news.length > 0 && (
    <section class="wrap block news-strip">
      <header class="block-head">
        <h2>اخبار</h2>
        <a class="quiet-link" href={url("/news/")}>همه‌ی اخبار ←</a>
      </header>
      <ul>
        {news.slice(0, 3).map((n) => (
          <li>
            <a href={url(`/news/${n.id}/`)}>
              <time datetime={n.data.date.toISOString().slice(0, 10)}>{shamsi(n.data.date)}</time>
              <span class="t">{n.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="wrap block">
    <header class="block-head">
      <h2>تازه‌های انتشارات</h2>
      <a class="quiet-link" href={url("/books/")}>همه‌ی کتاب‌ها ←</a>
    </header>
    <div class="grid books">
      {books.slice(0, 8).map((b) => (
        <BookCard slug={b.id} {...b.data} />
      ))}
    </div>
  </section>

  <section class="wrap block">
    <header class="block-head">
      <h2>آرشیو فصلنامه</h2>
      <a class="quiet-link" href={url("/magazine/")}>{fa(issues.length)} شماره ←</a>
    </header>
    <div class="grid issues">
      {issues.map((i) => <IssueCard {...i.data} />)}
    </div>
  </section>
</Base>

<style>
  /* Sits in the same column as every other section, so the cover's edge
     lines up with the headings and card grid below it. */
  .hero {
    background: var(--paper);
    border-bottom: 1px solid var(--rule);
    padding-block: clamp(1.4rem, 3.5vw, 2.8rem);
  }
  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
    align-items: stretch;
    gap: clamp(1.2rem, 3vw, 2.6rem);
  }
  @media (max-width: 820px) { .hero-grid { grid-template-columns: 1fr; } }
  .art {
    display: grid;
    place-items: center;
    padding: clamp(0.6rem, 2vw, 1.4rem);
  }
  .art img { width: min(78%, 310px); box-shadow: var(--cover-ring), var(--hero-shadow); }
  .copy {
    padding-block: clamp(0.6rem, 2vw, 1.6rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    max-width: 52ch;
  }
  .kicker {
    display: flex; align-items: center; gap: 0.6rem;
    font-weight: 700; font-size: var(--s--1); color: var(--a);
  }
  .bar { height: 3px; width: 34px; background: var(--a); border-radius: 2px; }
  .copy h1 { font-size: var(--s-3); font-weight: 900; }
  .sub { color: var(--ink-soft); font-size: var(--s-0); }
  .dek { color: var(--ink-soft); max-width: var(--measure); }
  .cta { display: flex; gap: 0.6rem; flex-wrap: wrap; margin-top: 0.4rem; }
  .btn {
    background: var(--a); color: var(--on-a);
    padding: 0.62rem 1.2rem; border-radius: 3px;
    font-weight: 700; font-size: var(--s--1);
  }
  .btn.ghost { background: transparent; color: var(--ink); box-shadow: inset 0 0 0 1px var(--rule); }
  .btn {
    transition: background-color 0.16s ease, color 0.16s ease, box-shadow 0.16s ease;
  }
  .btn:hover,
  .btn.ghost:hover {
    text-decoration: none;
    background: transparent;
    color: var(--a);
    box-shadow: inset 0 0 0 1px var(--a);
  }

  .block { padding-block: clamp(2.2rem, 5vw, 3.6rem); }
  .block-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; margin-bottom: 1.3rem; flex-wrap: wrap;
    padding-bottom: 0.5rem; border-bottom: 2px solid var(--ink);
  }
  .block-head h2 { font-size: var(--s-2); }
  .block-head a { font-size: var(--s--1); }
  .news-strip ul {
    list-style: none; margin: 0; padding: 0;
    display: grid; gap: 0 clamp(1rem, 2.5vw, 2rem);
    grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  }
  .news-strip li a {
    display: flex; flex-direction: column; gap: 0.3rem;
    padding-block: 0.2rem 0.9rem; padding-inline-end: 1.2rem;
  }
  .news-strip a:hover { text-decoration: none; }
  .news-strip a:hover .t { color: var(--accent); }
  .news-strip time { font-size: var(--s--1); color: var(--ink-faint); }
  .news-strip .t {
    font-size: var(--s-0); font-weight: 500; line-height: 1.6;
    transition: color 0.15s ease;
  }

  .grid { display: grid; gap: clamp(0.9rem, 2.2vw, 1.6rem); }
  .books,
  .issues { grid-template-columns: repeat(auto-fill, minmax(var(--cover-track), 1fr)); }
</style>
