---
/**
 * The publisher's content guide, served next to the panel it describes.
 *
 * Source is concept/cms-guide.html, which is also published as an artifact —
 * one file, two places it can be read. Editing that file updates both: this
 * page on the next deploy, the artifact on the next republish.
 *
 * Under /admin/, so robots.txt already disallows it and the sitemap filter
 * already skips it. Not linked from the site; it is reached by its URL.
 */
import guideHtml from "../../../concept/cms-guide.html?raw";
import "@fontsource-variable/vazirmatn";
import { url } from "../../lib/url";

// The eight issue accents, drawn as a strip under the header. The source file
// builds this with a script, which would not run here — set:html inserts
// markup but does not execute it — so it is rendered at build time instead.
const accents = [
  "#01FF80", "#BB252A", "#4F5336", "#F19F33",
  "#6F758A", "#F38F5B", "#73973B", "#C83A4D",
];
const strip = accents.map((c) => `<div style="background:${c}"></div>`).join("");

// The file is an artifact body: <title>, Google Fonts links, a <style>, the
// markup, then that script. The head material is lifted into the real head
// and the font comes from the site's own copy, since Google Fonts is not
// dependable from Iran — the same reason global.css self-hosts it.
const description =
  "راهنمای گام‌به‌گام افزودن کتاب، شماره‌ی فصلنامه و خبر به سایت — بدون نیاز به هیچ برنامه‌ای، فقط مرورگر.";
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(url("/og-default.jpg"), Astro.site);

const body = guideHtml
  .replace(/<title>[\s\S]*?<\/title>/, "")
  .replace(/<link rel="preconnect"[^>]*>/g, "")
  .replace(/<link rel="stylesheet" href="https:\/\/fonts\.googleapis\.com[^>]*>/g, "")
  .replace(/<script>[\s\S]*?<\/script>/, "")
  .replace('<div class="strip" id="strip"></div>', `<div class="strip">${strip}</div>`)
  .trim();
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>راهنمای افزودن محتوا — انتشارات پیام چارسو</title>
    <meta name="description" content={description} />

    {/* This page has its own head rather than going through Base, so the
        card has to be repeated here. It is how the guide reaches the
        publisher — sent as a link in a chat — so a bare URL with no title
        or image is the one place a preview genuinely matters.
        noindex keeps it out of search; it does not stop a chat app from
        fetching the card, which is what we want. */}
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="انتشارات پیام چارسو" />
    <meta property="og:locale" content="fa_IR" />
    <meta property="og:title" content="راهنمای افزودن محتوا به سایت" />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="انتشارات پیام چارسو" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="راهنمای افزودن محتوا به سایت" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={url("/favicon.ico")} sizes="any" />
    <style>
      /* The guide names the Google Fonts family; the self-hosted copy
         registers as "Vazirmatn Variable". Specificity, not order — the
         guide's own <style> comes later in the document. */
      html:root {
        --fa: "Vazirmatn Variable", "Vazirmatn", system-ui, Tahoma, sans-serif;
      }
    </style>
  </head>
  <body>
    <Fragment set:html={body} />
  </body>
</html>
