---
import "../styles/global.css";
import { url } from "../lib/url";

interface Props {
  title: string;
  description?: string;
  /** Issue pages pass their accent; everything else uses the house colour. */
  accent?: string;
  onAccent?: string;
}

const {
  title,
  description = "انتشارات پیام چارسو — ناشر کتاب‌های ادبی و هنری و فصلنامه‌ی تخصصی سینما و تئاتر",
  accent,
  onAccent,
} = Astro.props;

const nav = [
  { href: "/books/", label: "کتاب‌ها" },
  { href: "/magazine/", label: "فصلنامه" },
  { href: "/news/", label: "اخبار" },
  { href: "/about/", label: "درباره‌ی ما" },
  { href: "/contact/", label: "تماس" },
];

const path = Astro.url.pathname;
const style = accent
  ? `--accent:${accent};--on-accent:${onAccent ?? "#fff"}`
  : undefined;
---

<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // Applied before first paint so an explicit choice never flashes the
      // other theme. No stored value means follow the operating system.
      try {
        const t = localStorage.getItem("charsoo-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <link rel="canonical" href={new URL(path, Astro.site)} />
  </head>

  <body style={style}>
    <a class="skip" href="#main">پرش به محتوای اصلی</a>

    <header class="site-head">
      <div class="wrap head-inner">
        <a href={url("/")} class="brand" aria-label="انتشارات پیام چارسو — خانه">
          <img src={url("/wordmark.png")} alt="" width="120" height="47" />
        </a>
        <nav aria-label="فهرست اصلی">
          <ul>
            {nav.map((i) => (
              <li>
                <a href={url(i.href)} aria-current={path.startsWith(url(i.href)) ? "page" : undefined}>
                  {i.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
        <div class="controls">
          <button id="theme-toggle" type="button" class="icon-btn" aria-pressed="false"
                  aria-label="تغییر حالت نمایش">
            <svg class="moon" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <path fill="currentColor" d="M20 14.5A8.5 8.5 0 0 1 9.5 4a.75.75 0 0 0-1-.86 10 10 0 1 0 12.36 12.36.75.75 0 0 0-.86-1Z"/>
            </svg>
            <svg class="sun" viewBox="0 0 24 24" width="17" height="17" aria-hidden="true">
              <circle cx="12" cy="12" r="4.2" fill="currentColor"/>
              <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <path d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M18.7 5.3l-1.6 1.6M6.9 17.1l-1.6 1.6"/>
              </g>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main id="main"><slot /></main>

    <footer class="site-foot">
      <div class="wrap foot-inner">
        <div>
          <strong>انتشارات پیام چارسو</strong>
          <p>ناشر کتاب‌های ادبی و هنری</p>
          <p>فصلنامه‌ی تخصصی سینما و تئاتر — پروانه‌ی انتشار ۷۸۸۷۵</p>
        </div>
        <div>
          <p>تهران، خیابان آپادانا، خیابان مهناز (صابونچی)، پلاک ۴۸، طبقهٔ دوم</p>
          <p class="num ltr">۰۲۱۲۲۷۸۰۸۱۰</p>
          <p><a class="ltr" href="mailto:charsoomagazine@gmail.com">charsoomagazine@gmail.com</a></p>
          <p><a class="ltr" href="https://www.instagram.com/charsoopub/" rel="noopener">instagram.com/charsoopub</a></p>
        </div>
      </div>
    </footer>

    <style>
      .site-head {
        background: var(--paper);
        border-bottom: 1px solid var(--rule);
        position: sticky;
        top: 0;
        z-index: 20;
      }
      .head-inner {
        display: flex;
        align-items: center;
        gap: clamp(1rem, 3vw, 2rem);
        padding-block: 0.9rem;
        flex-wrap: wrap;
      }
      /* Without this the nav's min-content width (five unbreakable labels)
         is wider than a phone, and the whole page scrolls sideways. */
      nav { min-width: 0; }

      /* Phone: wordmark and controls share the top line, pages below,
         both starting from the right. */
      @media (max-width: 640px) {
        .head-inner {
          display: grid;
          grid-template-columns: auto 1fr;
          grid-template-areas:
            "brand controls"
            "nav   nav";
          gap: 0.55rem 1rem;
          align-items: center;
        }
        .brand { grid-area: brand; }
        .controls { grid-area: controls; justify-self: end; margin-inline-start: 0; }
        nav { grid-area: nav; }
        nav ul { gap: 0.7rem 1rem; }
      }
      .brand img {
        height: 34px;
        width: auto;
      }
      /* Inversion comes from a token so it is correct in all three theme
         states, including "system" where no data-theme attribute is set. */
      .brand img { filter: invert(var(--wordmark-invert)); }
      nav ul {
        display: flex;
        gap: clamp(0.8rem, 2.2vw, 1.6rem);
        list-style: none;
        margin: 0;
        padding: 0;
        flex-wrap: wrap;
      }
      /* One underline, drawn the same way in every state — only its colour
         changes. The global a:hover text-decoration is suppressed here so a
         second, differently-drawn line can never stack on top of this one. */
      nav a {
        font-size: var(--s-0);
        font-weight: 500;
        color: var(--ink-soft);
        box-shadow: inset 0 -2px 0 transparent;
        transition: color 0.15s ease, box-shadow 0.15s ease;
      }
      nav a:hover {
        color: var(--ink);
        box-shadow: inset 0 -2px 0 var(--ink);
        text-decoration: none;
      }
      nav a[aria-current="page"],
      nav a[aria-current="page"]:hover {
        color: var(--ink);
        box-shadow: inset 0 -2px 0 var(--accent);
      }
      .controls {
        margin-inline-start: auto;
        display: flex;
        align-items: center;
        gap: 0.35rem;
      }
      .icon-btn {
        display: grid;
        place-items: center;
        width: 30px;
        height: 30px;
        padding: 0;
        border: 0;
        border-radius: 3px;
        background: transparent;
        color: var(--ink-faint);
        cursor: pointer;
      }
      .icon-btn:hover { color: var(--ink); background: var(--raise); }
      .icon-btn svg { display: block; }
      .icon-btn .sun { display: var(--icon-sun); }
      .icon-btn .moon { display: var(--icon-moon); }

      .site-foot {
        border-top: 1px solid var(--rule);
        background: var(--paper);
        margin-top: clamp(3rem, 7vw, 5rem);
        padding-block: clamp(2rem, 5vw, 3.4rem);
        color: var(--ink-soft);
        font-size: var(--s--1);
      }
      .foot-inner {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
        gap: clamp(1.2rem, 3vw, 2.4rem);
      }
      .foot-inner strong { color: var(--ink); }
      .foot-inner p { margin: 0; }
    </style>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const btn = document.getElementById("theme-toggle");
        const systemDark = () => matchMedia("(prefers-color-scheme: dark)").matches;
        const current = () => root.dataset.theme || (systemDark() ? "dark" : "light");

        const label = () => {
          const dark = current() === "dark";
          btn.setAttribute("aria-pressed", String(dark));
          btn.setAttribute("aria-label", dark ? "تغییر به حالت روشن" : "تغییر به حالت تاریک");
          btn.title = dark ? "حالت روشن" : "حالت تاریک";
        };

        btn.addEventListener("click", () => {
          const next = current() === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          try { localStorage.setItem("charsoo-theme", next); } catch {}
          label();
        });

        // Follow the OS until the reader makes an explicit choice.
        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", () => {
          if (!root.dataset.theme) label();
        });

        label();
      })();
    </script>
  </body>
</html>
